<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional cloud AI providers (Gemini, Groq, OpenRouter, OpenAI, Claude). All traffic is https. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets get_device_info report whether the phone is online and on which transport. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Normal (install-time) permission needed to hand an alarm to the system Clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Model downloads: a foreground service keeps a multi-gigabyte download alive when the app is not on screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Shows download progress (asked at run time on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the user exempt the app from battery saving so a long download is not paused. Asked via a system dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Declared so the Access screen can ask for them. The data monitor is not built yet; the screen says so. Every one is off until the user allows it.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android forgets alarms when the phone restarts; this lets the app ask for the next reminder again after boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- The flashlight tool only works on phones with a flash; the app still installs without one. -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <!-- Declaring the permissions above would otherwise make these hardware features mandatory for installing. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Android 11 package visibility: the intents the tools resolve or launch. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <!-- Setup only asks whether the phone has a speech recogniser and a text-to-speech engine. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".JarvisApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wakes the app for reminders and automations, and after a restart or an app update. Not callable by other apps. -->
        <receiver
            android:name=".android.schedule.WakeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jarvis.ai.action.WAKE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".android.models.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
